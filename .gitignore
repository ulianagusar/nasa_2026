# --- large data, downloaded separately (see the commands below) ---
# NOAA ERSST v5, ~160 MB (GitHub does not accept files > 100 MB):
#   curl -L -o sst.mnmean.nc https://downloads.psl.noaa.gov/Datasets/noaa.ersst.v5/sst.mnmean.nc
*.nc
*.nc.gz

# MediaPipe hand-tracking model, ~7.5 MB:
#   mkdir -p models && curl -L -o models/hand_landmarker.task https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task
models/

# Natural Earth land outlines, ~1.6 MB:
#   mkdir -p data && curl -L -o data/ne_50m_land.geojson https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_50m_land.geojson
data/

# --- output of finger_map.py --selftest ---
selftest_out/

# --- video/audio/frames generated later ---
frames/
*.mp4
*.mov
*.wav
*.aiff

# --- voice samples ---
voice_samples/
